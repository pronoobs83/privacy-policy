# Copy to .env for local dev. On Hostinger set these in the Node.js dashboard instead.
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Production (Hostinger MySQL). Leave unset locally to use SQLite (SQLITE_PATH, default ./local.sqlite).
# DATABASE_URL=mysql://user:password@localhost:3306/zroute
# Optional Discord login
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
